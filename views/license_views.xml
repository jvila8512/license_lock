<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_license_manager_form" model="ir.ui.view">
        <field name="name">license.manager.form</field>
        <field name="model">license.manager</field>
        <field name="arch" type="xml">
            <form string="Licencia" create="false">
                <sheet>
                    <!-- ===== BANNER DE ESTADO ===== -->
                    <div class="oe_title">
                        <h1>
                            <field name="status" widget="badge"
                                   decoration-success="status == 'valid'"
                                   decoration-warning="status == 'unset'"
                                   decoration-danger="status in ('expired','invalid','clock_tampered')"/>
                        </h1>
                    </div>

                    <!-- ===== DÍAS RESTANTES (fuera de <group>: ancho completo controlado) ===== -->
                    <div invisible="status != 'valid'"
                         style="text-align:center;max-width:480px;margin:0 auto 16px;
                                padding:22px 16px;border-radius:12px;
                                background:#e8f5e9;border:2px solid #4caf50;overflow:hidden;">
                        <div style="font-size:3.2em;font-weight:bold;color:#2e7d32;line-height:1.1;">
                            <field name="days_remaining" nolabel="1"/>
                        </div>
                        <div style="font-size:1.1em;color:#388e3c;">días restantes</div>
                    </div>
                    <div invisible="status == 'valid'"
                         style="text-align:center;max-width:480px;margin:0 auto 16px;
                                padding:22px 16px;border-radius:12px;
                                background:#fbeaea;border:2px solid #e53935;">
                        <div style="font-size:1.3em;font-weight:bold;color:#c62828;">
                            Licencia no activa
                        </div>
                    </div>

                    <group>
                        <group string="Plan">
                            <field name="plan"/>
                            <field name="expires_on"/>
                            <field name="last_check"/>
                            <field name="error_message"/>
                        </group>
                        <group string="Instalación">
                            <field name="instance_uuid" nolabel="1"/>
                            <p class="text-muted">
                                Envía este código al proveedor por WhatsApp para que te
                                genere la licencia de esta instalación específica.
                            </p>
                        </group>
                    </group>

                    <group string="Código de licencia">
                        <field name="license_key" nolabel="1"
                               placeholder="Pega aquí el código que te dio el proveedor..."/>
                    </group>
                    <footer>
                        <button name="action_apply_license" type="object"
                                string="Aplicar / Revalidar" class="btn-primary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_license_manager" model="ir.actions.server">
        <field name="name">Licencia</field>
        <field name="model_id" ref="model_license_manager"/>
        <field name="state">code</field>
        <field name="code">action = env['license.manager'].action_open_license()</field>
    </record>

    <menuitem id="menu_license_root"
              name="Licencia"
              sequence="999"
              groups="base.group_system"/>

    <menuitem id="menu_license_config"
              name="Configurar licencia"
              parent="menu_license_root"
              action="action_license_manager"
              sequence="1"/>

</odoo>
