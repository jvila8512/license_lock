<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_license_manager_form" model="ir.ui.view">
        <field name="name">license.manager.form</field>
        <field name="model">license.manager</field>
        <field name="arch" type="xml">
            <form string="Licencia">
                <sheet>
                    <div class="oe_title">
                        <h1>Control de Licencia</h1>
                    </div>
                    <group>
                        <field name="status" widget="badge"
                               decoration-success="status == 'valid'"
                               decoration-danger="status in ('expired','invalid','clock_tampered')"/>
                        <field name="plan"/>
                        <field name="expires_on"/>
                        <field name="last_check"/>
                        <field name="error_message"/>
                    </group>
                    <group string="ID de esta instalación">
                        <field name="instance_uuid" nolabel="1"/>
                        <p class="text-muted">
                            Envía este código al proveedor por WhatsApp para que te genere
                            la licencia de esta instalación específica.
                        </p>
                    </group>
                    <group string="Código de licencia">
                        <field name="license_key" nolabel="1" placeholder="Pega aquí el código que te dio el proveedor..."/>
                    </group>
                    <footer>
                        <button name="action_apply_license" type="object"
                                string="Aplicar / Revalidar" class="btn-primary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_license_manager" model="ir.actions.act_window">
        <field name="name">Licencia</field>
        <field name="res_model">license.manager</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_license_root"
              name="Licencia"
              sequence="999"
              groups="base.group_system"/>

    <menuitem id="menu_license_config"
              name="Configurar licencia"
              parent="menu_license_root"
              action="action_license_manager"
              sequence="1"/>

</odoo>
