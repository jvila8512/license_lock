<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="license_page_template" name="Licencia">
        <t t-call="web.layout">
            <t t-set="head_website">True</t>
            <div style="max-width:560px;margin:60px auto;font-family:sans-serif;">

                <!-- ===== ENCABEZADO ===== -->
                <div style="text-align:center;margin-bottom:24px;">
                    <h2 t-attf-style="color:{{ '#2e7d32' if not blocked else '#a94442' }};margin-bottom:4px;">
                        <t t-if="blocked">Sistema bloqueado</t>
                        <t t-if="not blocked">Gestión de licencia</t>
                    </h2>
                    <p style="color:#777;margin:0;">
                        <t t-esc="company_name"/> · <t t-esc="user_name"/>
                    </p>
                </div>

                <!-- ===== DÍAS RESTANTES (Bien grande) ===== -->
                <t t-if="plan and days_remaining is not False">
                    <div t-attf-style="text-align:center;padding:20px;border-radius:12px;margin-bottom:20px;
                                        background:{{ '#e8f5e9' if days_remaining > 0 else '#fff3e0' if days_remaining >= 0 else '#fbeaea' }};
                                        border:2px solid {{ '#4caf50' if days_remaining > 0 else '#ff9800' if days_remaining >= 0 else '#e53935' }};">
                        <t t-if="days_remaining > 0">
                            <div style="font-size:3em;font-weight:bold;color:#2e7d32;line-height:1.1;">
                                <t t-esc="days_remaining"/>
                            </div>
                            <div style="font-size:1.1em;color:#388e3c;margin-top:4px;">
                                días restantes
                            </div>
                        </t>
                        <t t-if="days_remaining == 0">
                            <div style="font-size:2em;font-weight:bold;color:#e65100;line-height:1.1;">
                                VENCE HOY
                            </div>
                            <div style="font-size:1em;color:#ef6c00;margin-top:4px;">
                                Actualizá la licencia antes de que expire.
                            </div>
                        </t>
                        <t t-if="days_remaining < 0">
                            <div style="font-size:3em;font-weight:bold;color:#c62828;line-height:1.1;">
                                <t t-esc="0 - days_remaining"/>
                            </div>
                            <div style="font-size:1.1em;color:#d32f2f;margin-top:4px;">
                                días de vencida
                            </div>
                        </t>
                    </div>
                </t>

                <!-- ===== INFO DE LA LICENCIA ===== -->
                <div t-attf-style="padding:14px 16px;border-radius:8px;margin-bottom:20px;
                                    background:{{ '#eafaf0' if not blocked else '#fbeaea' }};
                                    border:1px solid {{ '#b7e4c7' if not blocked else '#e6b3b3' }};">
                    <p t-if="plan" style="margin:0 0 4px;"><b>Plan:</b> <t t-esc="plan"/></p>
                    <p t-if="expires_on" style="margin:0 0 4px;"><b>Vence:</b> <t t-esc="expires_on"/></p>
                    <p t-if="error_message" style="margin:0;color:#555;font-size:0.9em;">
                        <t t-esc="error_message"/>
                    </p>
                    <p t-if="not plan and not error_message" style="margin:0;color:#555;">
                        No hay ninguna licencia cargada todavía.
                    </p>
                </div>

                <!-- ===== INSTANCE ID ===== -->
                <div style="padding:14px 16px;background:#f5f5f5;border-radius:8px;margin-bottom:20px;text-align:center;">
                    <p style="margin:0 0 6px;font-size:0.9em;color:#555;">
                        ID de esta instalación &#8212; envíaselo al proveedor por WhatsApp
                        para que te genere la licencia:
                    </p>
                    <p style="margin:0;font-family:monospace;font-size:1.3em;font-weight:bold;
                              background:#fff;border:1px dashed #999;border-radius:6px;padding:8px;">
                        <t t-esc="instance_uuid"/>
                    </p>
                </div>

                <!-- ===== FORMULARIO PARA ACTUALIZAR LICENCIA ===== -->
                <form action="/license_lock/apply" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <label style="display:block;margin-bottom:6px;font-size:0.9em;color:#555;">
                        Pegar código de licencia:
                    </label>
                    <textarea name="license_key" rows="3"
                              style="width:100%;box-sizing:border-box;padding:8px;font-family:monospace;"
                              placeholder="ODOO-MENSUAL-2026-08-27-XXXXXXXXXXXX-XXXXXXXX"
                              oninput="document.getElementById('apply-btn').disabled = !this.value.trim()"></textarea>
                    <button id="apply-btn" type="submit"
                            style="margin-top:10px;padding:9px 22px;
                                   background:#2e7d32;color:#fff;border:none;border-radius:6px;
                                   cursor:pointer;"
                            disabled>
                        Aplicar licencia
                    </button>
                </form>

                <!-- ===== BOTÓN PARA VOLVER A ODOO (solo si no está bloqueado) ===== -->
                <div t-if="not blocked" style="text-align:center;margin-top:26px;">
                    <a href="/web" style="text-decoration:none;color:#2e7d32;font-weight:bold;">
                        Continuar a Odoo &#8594;
                    </a>
                </div>
            </div>
        </t>
    </template>
</odoo>
